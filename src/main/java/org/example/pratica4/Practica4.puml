
@startuml

title Diagrama de Clases - Eight Off

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

top to bottom direction

package "DeckOfCards" {

    interface "Comparable<Carta>" as Comparable

    abstract class Carta {
        -valor: int
        #palo: Palo
        -color: String
        -valorBajo: int
        -faceup: boolean

        +Carta(valor: int, palo: Palo, color: String)
        +makeFaceDown(): void
        +makeFaceUp(): void
        +isFaceup(): boolean
        +toString(): String
        +tieneElMismoValor(carta: Carta): boolean
        +tieneElMismoPalo(palo: Palo): boolean
        +esLaSiguiente(carta: Carta): boolean
        +getValor(): int
        +getPalo(): Palo
        +getColor(): String
        +getValorBajo(): int
        {abstract} +compareTo(carta: Carta): int
    }

    class CartaInglesa {
    }

    enum Palo {
    }

    class Mazo {
        -cartas: ListaCircularDoble<CartaInglesa>
        -cantidad: int
        +Mazo()
        -llenar(): void
        -mezclar(): void
        +obtenerUnaCarta(): CartaInglesa
        +ordenar(): void
    }
}

package "Logica" {

    class "Nodo<T>" as Nodo {
        -dato: T
        -next: Nodo<T>
        +Nodo(dato: T)
        +getDato(): T
        +setDato(dato: T): void
        +getNext(): Nodo<T>
        +setNext(next: Nodo<T>): void
    }

    class "ListaSimple<T>" as ListaSimple {
        -inicio: Nodo<T>
        +insertarInicio(dato: T): void
        +insetarFin(dato: T): void
        +eliminarInicio(): T
        +eliminarFin(): T
    }

    class "NodoDoble<T>" as NodoDoble {
        -info: T
        -sig: NodoDoble<T>
        -ant: NodoDoble<T>
        +NodoDoble(info: T)
        +getInfo(): T
        +setInfo(info: T): void
        +getSig(): NodoDoble<T>
        +setSig(sig: NodoDoble<T>): void
        +getAnt(): NodoDoble<T>
        +setAnt(ant: NodoDoble<T>): void
    }

    class "ListaCircularDoble<T>" as ListaCircularDoble {
        -inicio: NodoDoble<T>
        -fin: NodoDoble<T>
        +insertarInicio(dato: T): void
        +insertarFin(dato: T): void
        +eliminarInicio(): T
        +eliminarFin(): T
        +estaVacia(): boolean
    }

    class "Pila<T>" as Pila {
        -pila: T[]
        -tope: int

        +Pila()
        +Pila(capacidad: int)
        +Push(dato: T): boolean
        +Pop(): T
        +llena(): boolean
        +vacia(): boolean
    }

    class TableauDeck {
        -cartas: ListaSimple<CartaInglesa>
        -ultima: CartaInglesa

        +inicializar(carta: CartaInglesa): void
        +sePuedeAgregarCarta(carta: CartaInglesa): boolean
        +agregarCarta(carta: CartaInglesa): boolean
        +verUltimaCarta(): CartaInglesa
        +removerUltimaCarta(): CartaInglesa
        +isEmpty(): boolean
        +getUltimaCarta(): CartaInglesa
    }

    class FoundationDeck {
        -palo: Palo
        -cartas: ListaSimple<CartaInglesa>
        -ultima: CartaInglesa
        -cantidad: int

        +FoundationDeck(palo: Palo)
        +FoundationDeck(carta: CartaInglesa)
        +agregarCarta(carta: CartaInglesa): boolean
        +removerUltimaCarta(): CartaInglesa
        +estaVacio(): boolean
        +getUltimaCarta(): CartaInglesa
        +toString(): String
    }

    class EightOffGame {
        -columnas: TableauDeck[]
        -finales: FoundationDeck[]
        -libres: CartaInglesa[]
        -mazo: Mazo
        -historial: Pila<Movimiento>

        +EightOffGame()
        +iniciar(): void
        +moverColumna(origen: int, destino: int): boolean
        +moverALibre(origen: int, destino: int): boolean
        +moverLibreAColumna(origen: int, destino: int): boolean
        +moverAFinal(origen: int): boolean
        +moverLibreAFinal(origen: int): boolean
        +gano(): boolean
        +deshacer(): boolean
        +obtenerPista(): String
        +hayMovimientos(): boolean
    }

    class Movimiento {
        -origen: int
        -destino: int
        -carta: CartaInglesa
        -tipoOrigen: String
        -tipoDestino: String

        +Movimiento()
        +getOrigen(): int
        +getDestino(): int
        +getCarta(): CartaInglesa
    }
}

' Herencia e interfaz
Comparable <|.. Carta
Carta <|-- CartaInglesa

' Relaciones de las cartas
Carta --> Palo

' Listas
ListaSimple *-- Nodo
ListaCircularDoble *-- NodoDoble

' Mazo
Mazo *-- ListaCircularDoble

' Columnas y montones finales
TableauDeck *-- ListaSimple
FoundationDeck *-- ListaSimple
FoundationDeck --> Palo

' Control del juego}
EightOffGame *-- Mazo
EightOffGame *-- TableauDeck
EightOffGame *-- FoundationDeck
EightOffGame *-- Pila

' Historial de movimientos
Pila ..> Movimiento : guarda
Movimiento --> CartaInglesa

@enduml
